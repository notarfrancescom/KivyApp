# ==============================================================================
# 7a. RedWineInfoScreen (name: 'info_rosso') CON STRUTTURA RESPONSIVA
# ==============================================================================
<RedWineInfoScreen>:
    name: 'info_rosso'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCHOR (Fissi in alto, fuori dai BoxLayout)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a tutte le altre

        MenuButton:
            id: menu_button
            # Coordinate bloccate per eliminare il "salto" visivo
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # -----------------------------------------------------------------
        # 2. BOX CONTENITORE VERTICALE PRINCIPALE
        # -----------------------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # --- RIMOSSO VECCHIO FLOATLAYOUT DEL MENU ---
                # Spacer per l'area del MenuButton
                Widget:
                    size_hint_y: None
                    height: dp(40)

                # Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    Image:
                        source: 'materiale/scheda_degustazione_rosso.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    Image:
                        source: 'materiale/base_info_rosso.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(15)
                    padding: dp(0), dp(10), dp(0), dp(10)

                    # Blocco vuoto iniziale per spazio
                    Widget:
                        size_hint_y: None
                        height: dp(10)

                    # Nome vino rosso
                    BoxLayout:
                        id: nome_rosso_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        RedWineLabel:
                            text: "Nome"
                            size_hint_x: 0.35 # Bilanciamento label/input
                        TextInput:
                            id: nome_rosso
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Nome del vino"
                            multiline: False
                            size_hint_x: 0.65

                    # Produttore vino rosso
                    BoxLayout:
                        id: produttore_rosso_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        RedWineLabel:
                            text: "Produttore"
                            size_hint_x: 0.35
                        TextInput:
                            id: produttore_rosso
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Produttore del vino"
                            multiline: False
                            size_hint_x: 0.65

                    # Annata vino rosso
                    BoxLayout:
                        id: annata_rosso_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        RedWineLabel:
                            text: "Annata"
                            size_hint_x: 0.35
                        TextInput:
                            id: annata_rosso
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Anno (es. 2022)"
                            multiline: False
                            input_type: 'number' # Suggerimento per la tastiera numerica
                            input_filter: 'int' # Permette solo numeri interi
                            size_hint_x: 0.65

                    # Gradazione alcolica vino rosso (Spinner)
                    BoxLayout:
                        id: gradazione_alcolica_rosso_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        RedWineLabel:
                            text: "Vol. Alcolico"
                            size_hint_x: 0.35
                        Spinner:
                            id: alcol_rosso
                            background_normal: ""
                            background_color: (0.6, 0, 0, 1) # Colore Rosso
                            color: (1, 1, 1, 1)
                            font_name: 'materiale/comicbd.ttf'
                            text: "Gradazione alcolica"
                            font_size: '12sp'
                            # Genera valori come 10.0, 10.5, ..., 18.0
                            values: [f'{x/10.0:.1f}' for x in range(100, 185, 5)]
                            text_size: self.size
                            halign: 'center'
                            valign: 'middle'
                            size_hint_x: 0.65

            # Controlli di navigazione (fissi in basso)
            BoxLayout:
                size_hint_y: None
                height: dp(60)
                spacing: dp(20)
                padding: dp(10)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'conclusioni_rosso'

                NavigationButton:
                    id: nav_salva_rosso
                    text: "Salva Scheda"
                    on_release: app.show_confirm_popup('rosso', root)

