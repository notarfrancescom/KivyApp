                                    text: "Basilico"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                SelectionButton:
                                    text: "Menta"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                SelectionButton:
                                    text: "Rosa"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                SelectionButton:
                                    text: "Violetta"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                # Spaziatori per riempire l'altezza
                                # Spaziatori per allineare l'altezza con le altre due colonne (per 6 righe di bottoni)
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone

                            # Profumo Terziari (GridLayout verticale a colonna singola)
                            GridLayout:
                                id: profumo_terziari_rosato_box
                                cols: 1
                                spacing: dp(2)
                                PinkWineLabel:
                                    text: "Terziari"
                                    font_size: '13sp'
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Cannella"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                SelectionButton:
                                    text: " Note \nminerali"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                SelectionButton:
                                    text: "Vaniglia"
                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)
                                # Spaziatori per riempire l'altezza (manca lo Zafferano)
                                Widget:
                                Widget:
                                Widget:
                                Widget:


                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'vista_rosato'

                    # Logica di disabilitazione/opacità se si è in modalità modifica
                    opacity: 1
                    disabled: False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'palato_rosato'

# ==============================================================================
# 5a. RedWineTasteScreen (name: 'palato_rosso')
# ==============================================================================
<RedWineTasteScreen>:
    name: 'palato_rosso'

    FloatLayout:
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCHOR (Fissi in alto, fuori dai Box)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a tutte le altre

        MenuButton:
            id: menu_button
            # Coordinate bloccate per eliminare il "salto" visivo
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # -----------------------------------------------------------------
        # 2. BOX CONTENITORE VERTICALE PRINCIPALE
        # -----------------------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO (Fisso in alto)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # --- RIMOSSO VECCHIO FLOATLAYOUT DEL MENU ---
                # Aggiungiamo lo spacer per non sovrapporre i contenuti al MenuButton
                Widget:
                    size_hint_y: None
                    height: dp(40)

                # Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    Image:
                        source: 'materiale/scheda_degustazione_rosso.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    Image:
                        source: 'materiale/base_palato_rosso.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(0), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12) # Spaziatura tra le sezioni
                    padding: dp(0), dp(10), dp(8), dp(10) # Padding top/bottom interno
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica

                    # ----------------------------------------------
                    # Dolcezza (4 bottoni) - size_hint_x: 0.3 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: dolcezza_rosso_box
                        size_hint_y: None
                        height: dp(20) # Altezza COMPATTATA
                        spacing: dp(6)
                        padding: dp(5), 0, dp(5), 0
                        RedWineLabel:
                            text: "Dolcezza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_dolcezza_secco
                            text: "Secco"
                            size_hint_x: 0.13
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('dolcezza_rosso', self, dolcezza_rosso_box.children)
                        SelectionButton:
                            id: btn_dolcezza_abboccato
                            text: "Abboccato"
                            size_hint_x: 0.24
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            on_release: root.on_button_press('dolcezza_rosso', self, dolcezza_rosso_box.children)
                        SelectionButton:
                            id: btn_dolcezza_amabile
                            text: "Amabile"
                            size_hint_x: 0.17
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            on_release: root.on_button_press('dolcezza_rosso', self, dolcezza_rosso_box.children)
                        SelectionButton:
                            id: btn_dolcezza_dolce
                            text: "Dolce"
                            size_hint_x: 0.12
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            on_release: root.on_button_press('dolcezza_rosso', self, dolcezza_rosso_box.children)

                    # ----------------------------------------------
                    # Acidità (3 bottoni) - size_hint_x: 0.4 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: acidita_rosso_box
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        RedWineLabel:
                            text: "Acidità"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_acidita_bassa
                            text: "Bassa"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('acidita_rosso', self, acidita_rosso_box.children)
                        SelectionButton:
                            id: btn_acidita_media
                            text: "Media"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('acidita_rosso', self, acidita_rosso_box.children)
                        SelectionButton:
                            id: btn_acidita_alta
                            text: "Alta"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('acidita_rosso', self, acidita_rosso_box.children)

                    # ----------------------------------------------
                    # Tannicità (3 bottoni) - size_hint_x: 0.4 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: tannicita_rosso_box
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        RedWineLabel:
                            text: "Tannicità"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_tannicita_bassa
                            text: "Bassa"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('tannicita_rosso', self, tannicita_rosso_box.children)
                        SelectionButton:
                            id: btn_tannicita_media
                            text: "Media"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('tannicita_rosso', self, tannicita_rosso_box.children)
                        SelectionButton:
                            id: btn_tannicita_alta
                            text: "Alta"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('tannicita_rosso', self, tannicita_rosso_box.children)

                    # ----------------------------------------------
                    # Livello Alcolico (3 bottoni) - size_hint_x: 0.4 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: livello_alcolico_rosso_box
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        RedWineLabel:
                            text: "Liv.Alcolico"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_alcol_basso
                            text: "Basso"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('livello_alcolico_rosso', self, livello_alcolico_rosso_box.children)
                        SelectionButton:
                            id: btn_alcol_medio
                            text: "Medio"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('livello_alcolico_rosso', self, livello_alcolico_rosso_box.children)
                        SelectionButton:
                            id: btn_alcol_alto
                            text: "Alto"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('livello_alcolico_rosso', self, livello_alcolico_rosso_box.children)

                    # ----------------------------------------------
                    # Corpo (3 bottoni) - size_hint_x: 0.4 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: corpo_rosso_box
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        RedWineLabel:
                            text: "Corpo"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: corpo_basso
                            text: "Basso"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('corpo_rosso', self, corpo_rosso_box.children)
                        SelectionButton:
                            id: corpo_medio
                            text: "Medio"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('corpo_rosso', self, corpo_rosso_box.children)
                        SelectionButton:
                            id: corpo_alto
                            text: "Alto"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('corpo_rosso', self, corpo_rosso_box.children)

                    # ----------------------------------------------
                    # Sapore - Griglia (size_hint_x: 0.4 per la label - **CORRETTO**)
                    # ----------------------------------------------
                    BoxLayout:
                        id: sapore_rosso_box
                        size_hint_y: None
                        height: dp(195)
                        spacing: dp(5)
                        padding: dp(20), 0, dp(0), 0
                        RedWineLabel:
                            text: "Sapore"
                            size_hint_x: 0.23 # <-- Allineato con gli altri
                            font_size: '14sp'
                            valign: 'center'
                            text_size: self.size
                            padding_y: dp(0)
                        GridLayout:
                            id: sapore_grid_content
                            size_hint_x: 0.77 # <-- Adeguato al 0.4 della label
                            cols: 3
                            spacing: dp(5)
                            padding: dp(5)

                            # Row 1: Intestazioni (Altezza fissa dp(7))
                            RedWineLabel:
                                text: "Primari"
                                font_size: '12sp'
                                color: 0.6, 0, 0, 1
                                size_hint_y: None
                                height: dp(12)
                            RedWineLabel:
                                text: "Secondari"
                                font_size: '12sp'
                                color: 0.6, 0, 0, 1
                                size_hint_y: None
                                height: dp(12)
                            RedWineLabel:
                                text: "Terziari"
                                font_size: '12sp'
                                color: 0.6, 0, 0, 1
                                size_hint_y: None
                                height: dp(12)

                            # Bottoni della griglia - Altezza uniforme dp(20)
                            # Row 2: Ciliegia / Caffè / Cacao
                            SelectionButton:
                                id: sapore_ciliegia
                                text: "Ciliegia"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_caffe
                                text: "Caffè"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_cacao
                                text: "Cacao"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 3: Mora / Caramello / Foglie Secche
                            SelectionButton:
                                id: sapore_mora
                                text: "Mora"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_caramello
                                text: "Caramello"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_foglie_secche
                                text: "Foglie\nSecche"
                                font_size: '9sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 4: Peperone verde / Ferro / Funghi
                            SelectionButton:
                                id: sapore_peperone_verde
                                text: "Peperone\n verde"
                                font_size: '9sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_ferro
                                text: "Ferro"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_funghi
                                text: "Funghi"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 5: Prugna / Frutta Secca / Spezie
                            SelectionButton:
                                id: sapore_prugna
                                text: "Prugna"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_frutta_secca
                                text: "Frutta\n Secca"
                                font_size: '9sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_spezie
                                text: "Spezie"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 6: Ribes nero / Miele / Tabacco
                            SelectionButton:
                                id: sapore_ribes_nero
                                text: "Ribes\n nero"
                                font_size: '9sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_miele
                                text: "Miele"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_tabacco
                                text: "Tabacco"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 7: (Spazio) / Pane Tostato / Vaniglia
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            SelectionButton:
                                id: sapore_pane_tostato
                                text: " Pane\nTostato"
                                font_size: '9sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            SelectionButton:
                                id: sapore_vaniglia
                                text: "Vaniglia"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)

                            # Row 8: (Spazio) / Pietra / (Spazio)
                            Label: # Placeholder
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            SelectionButton:
                                id: sapore_pietra
                                text: "Pietra"
                                font_size: '13sp'
                                color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                size_hint_y: None
                                height: dp(20)
                                on_release: root.on_multiple_select_press('sapore_rosso', self)
                            Label: # Placeholder
                                text: ""
                                size_hint_y: None
                                height: dp(20)

                    # ----------------------------------------------
                    # Persistenza (3 bottoni) - size_hint_x: 0.4 per la label
                    # ----------------------------------------------
                    BoxLayout:
                        id: persistenza_rosso_box
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(10), 0, dp(5), 0
                        RedWineLabel:
                            text: "Persistenza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_persistenza_corta
                            text: "Corta"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('persistenza_rosso', self, persistenza_rosso_box.children)
                        SelectionButton:
                            id: btn_persistenza_media
                            text: "Media"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('persistenza_rosso', self, persistenza_rosso_box.children)
                        SelectionButton:
                            id: btn_persistenza_lunga
                            text: "Lunga"
                            font_size: '13sp'
                            color: 0.6, 0.2, 0.4, 1
                            size_hint_x: 0.25
                            height: dp(20)
                            on_release: root.on_button_press('persistenza_rosso', self, persistenza_rosso_box.children)


                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso) - ALTEZZA FISSA: 60dp
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'naso_rosso'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1 #if app.card_to_update_id == None else 0
                    disabled: False #True if app.card_to_update_id != None else False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'conclusioni_rosso'


# ==============================================================================
# 5b. WhiteWineTasteScreen (name: 'palato_bianco') CON STRUTTURA RESPONSIVA
# ==============================================================================
<WhiteWineTasteScreen>:
    name: 'palato_bianco'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto)
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130) # Altezza fissa per coerenza
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor
                FloatLayout:
                    size_hint_y: None
                    height: dp(40)

                    # 1a. ANCORA INVISIBILE
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Bianco (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_bianco.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Palato Bianco (Titolo "Analisi Gusto-Olfattiva")
                    Image:
                        source: 'materiale/base_palato_bianco.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(0), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(0), dp(10), dp(8), dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    # ----------------------------------------------
                    # DOLCEZZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: dolcezza_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(6)
                        padding: dp(5), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Dolcezza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_dolcezza_secco
                            text: "Secco"
                            size_hint_x: 0.13
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('dolcezza_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_abboccato
                            text: "Abboccato"
                            size_hint_x: 0.24
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('dolcezza_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_amabile
                            text: "Amabile"
                            size_hint_x: 0.17
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('dolcezza_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_dolce
                            text: "Dolce"
                            size_hint_x: 0.12
                            height: dp(20)
                            font_size: '13sp'
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('dolcezza_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # ACIDITÀ (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: acidita_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Acidità"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_acidita_bassa
                            text: "Bassa"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('acidita_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_acidita_media
