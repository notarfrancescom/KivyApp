                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10)

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'naso_bianco'

                    # Logica di disabilitazione/opacità se si è in modalità modifica
                    opacity: 1
                    disabled: False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'conclusioni_bianco'


# ==============================================================================
# 5c. PinkWineTasteScreen (name: 'palato_rosato') CON STRUTTURA RESPONSIVA
# ==============================================================================
<PinkWineTasteScreen>:
    name: 'palato_rosato'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto)
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130) # Altezza fissa per coerenza
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor
                FloatLayout:
                    size_hint_y: None
                    height: dp(40)

                    # 1a. ANCORA INVISIBILE
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Rosato (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_rosato.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Palato Rosato (Titolo "Analisi Gusto-Olfattiva")
                    Image:
                        source: 'materiale/base_palato_rosato.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(12)
                    padding: dp(0), dp(10), dp(8), dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    # ----------------------------------------------
                    # DOLCEZZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: dolcezza_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(6)
                        padding: dp(5), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Dolcezza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                            #text_size: self.size
                        SelectionButton:
                            id: btn_dolcezza_secco
                            text: "Secco"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.13
                            color: 0.85, 0.6, 0.8, 1.0 # Colore Rosato
                            on_release: root.on_button_press('dolcezza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_abboccato
                            text: "Abboccato"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.24
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('dolcezza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_amabile
                            text: "Amabile"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.17
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('dolcezza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_dolcezza_dolce
                            text: "Dolce"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.12
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('dolcezza_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # ACIDITÀ (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: acidita_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Acidità"
                            size_hint_x: 0.3
                            font_size: '14sp'
                            #text_size: self.size
                        SelectionButton:
                            id: btn_acidita_bassa
                            text: "Bassa"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('acidita_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_acidita_media
                            text: "Media"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('acidita_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_acidita_alta
                            text: "Alta"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('acidita_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # TANNICITÀ (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: tannicita_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Tannicità"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_tannicita_bassa
                            text: "Bassa"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('tannicita_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_tannicita_media
                            text: "Media"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('tannicita_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_tannicita_alta
                            text: "Alta"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('tannicita_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # LIVELLO ALCOLICO (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: livello_alcolico_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Liv.Alcolico"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_alcol_basso
                            text: "Basso"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('livello_alcolico_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_alcol_medio
                            text: "Medio"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('livello_alcolico_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_alcol_alto
                            text: "Alto"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('livello_alcolico_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # CORPO (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: corpo_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Corpo"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: corpo_basso
                            text: "Basso"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('corpo_rosato', self, self.parent.children)
                        SelectionButton:
                            id: corpo_medio
                            text: "Medio"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('corpo_rosato', self, self.parent.children)
                        SelectionButton:
                            id: corpo_alto
                            text: "Alto"
                            font_size: '13sp'
                            height: dp(20)
                            size_hint_x: 0.25
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('corpo_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # SAPORE (GRIGLIA DI SELEZIONE MULTIPLA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: sapore_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(195)
                        spacing: dp(5)
                        padding: dp(20), 0, dp(0), 0

                        PinkWineLabel:
                            text: "Sapore"
                            size_hint_x: 0.3
                            font_size: '14sp'
                            valign: 'center'
                            text_size: self.size
                            padding_y: dp(0)
                        GridLayout:
                            id: sapore_grid_content
                            size_hint_x: 0.77
                            cols: 3
                            spacing: dp(5)
                            padding: dp(5)

                            # Row 1: Intestazioni (Altezza fissa dp(7))
                            PinkWineLabel:
                                text: "Primari"
                                font_size: '12sp'
                                color: 0.7, 0.4, 0.7, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)
                            PinkWineLabel:
                                text: "Secondari"
                                font_size: '12sp'
                                color: 0.7, 0.4, 0.7, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)
                            PinkWineLabel:
                                text: "Terziari"
                                font_size: '12sp'
                                color: 0.7, 0.4, 0.7, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)
                            # Bottoni della griglia - Altezza uniforme dp(20)
                            # Row 2: Arancia rossa / Basilico / Cannella
                            SelectionButton:
                                id: sapore_arancia_rossa
                                text: "Arancia\n rossa"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_basilico
                                text: "Basilico"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_cannella
                                text: "Cannella"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            # Row 3: Ciliegia / Menta / Note minerali
                            SelectionButton:
                                id: sapore_ciliegia
                                text: "Ciliegia"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_menta
                                text: "Menta"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_note_minerali
                                text: "  Note\nminerali"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            # Row 4: Fragola / Rosa / Vaniglia
                            SelectionButton:
                                id: sapore_fragola
                                text: "Fragola"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_rosa
                                text: "Rosa"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_vaniglia
                                text: "Vaniglia"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            # Row 5: Lampone / Violetta / (Spazio)
                            SelectionButton:
                                id: sapore_lampone
                                text: "Lampone"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            SelectionButton:
                                id: sapore_violetta
                                text: "Violetta"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 6: Mango / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_mango
                                text: "Mango"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 7: Melone / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_melone
                                text: "Melone"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 8: Pompelmo rosa / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_pompelmo_rosa
                                text: "Pompelmo\n rosa"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('sapore_rosato', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)

                    # ----------------------------------------------
                    # PERSISTENZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: persistenza_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(10), 0, dp(5), 0
                        PinkWineLabel:
                            text: "Persistenza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: persistenza_corta
                            text: "Corta"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('persistenza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: persistenza_media
                            text: "Media"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('persistenza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: persistenza_lunga
                            text: "Lunga"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('persistenza_rosato', self, self.parent.children)

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10)

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'naso_rosato'

                    # Logica di disabilitazione/opacità se si è in modalità modifica
                    opacity: 1
                    disabled: False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'conclusioni_rosato'



# ==============================================================================
# 6a. RedWineEpilogueScreen (name: 'conclusioni_rosso') CON STRUTTURA RESPONSIVA
# ==============================================================================
<RedWineEpilogueScreen>:
    name: 'conclusioni_rosso'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCHOR (Fissi in alto, fuori dai BoxLayout)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a tutte le altre

        MenuButton:
            id: menu_button
            # Coordinate bloccate per eliminare il "salto" visivo
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # -----------------------------------------------------------------
        # 2. BOX CONTENITORE VERTICALE PRINCIPALE
        # -----------------------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # --- RIMOSSO VECCHIO FLOATLAYOUT DEL MENU ---
                # Aggiungiamo lo spacer per non sovrapporre i contenuti al MenuButton
                Widget:
                    size_hint_y: None
                    height: dp(40)

                # Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    Image:
                        source: 'materiale/scheda_degustazione_rosso.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    Image:
                        source: 'materiale/base_conclusioni_rosso.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(15)
                    padding: dp(0), dp(10), dp(0), dp(10)

                    # Livello di qualità
                    BoxLayout:
                        size_hint_y: None
                        height: dp(300) # Altezza sufficiente a contenere 6 bottoni + label
                        spacing: dp(8)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(15), 0, dp(15), 0
                        RedWineLabel: # Utilizzo di RedWineLabel
                            text: "Livello di Qualità"
                            font_size: '18sp'
                            size_hint_x: 0.5
                            size_hint_y: 1.0
                            valign: 'center'
                            text_size: self.size
                            padding_y: dp(10)

                        BoxLayout: # Contenitore dei 6 bottoni
                            id: qualita_rosso_box
                            orientation: 'vertical'
                            spacing: dp(5)
                            size_hint_y: None
                            height: self.minimum_height
                            size_hint_x: 0.5

                            SelectionButton:
                                id: qualita_difettoso
                                text: "Difettoso"
                                font_size: '18sp'
                                size_hint_x: 1.0 # 100% della Box
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1 # Colore Rosso
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)
                            SelectionButton:
                                id: qualita_mediocre
                                text: "Mediocre"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)
                            SelectionButton:
                                id: qualita_discreto
                                text: "Discreto"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)
                            SelectionButton:
                                id: qualita_buono
                                text: "Buono"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)
                            SelectionButton:
                                id: qualita_molto_buono
                                text: "Molto Buono"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)
                            SelectionButton:
                                id: qualita_eccellente
                                text: "Eccellente"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.6, 0.2, 0.4, 1
                                on_release: root.on_button_press('qualita_rosso', self, self.parent.children)

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10)


            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'palato_rosso'

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'info_rosso'

# ==================================================================================
# 6b. WhiteWineEpilogueScreen (name: 'conclusioni_bianco') CON STRUTTURA RESPONSIVA
# ==================================================================================
<WhiteWineEpilogueScreen>:
    name: 'conclusioni_bianco'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto)
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130) # Altezza fissa per coerenza
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor
                FloatLayout:
                    size_hint_y: None
                    height: dp(40)

                    # 1a. ANCORA INVISIBILE
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Bianco (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_bianco.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Conclusioni Bianco (Titolo "Conclusioni")
                    Image:
                        source: 'materiale/base_conclusioni_bianco.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(15)
                    padding: dp(0), dp(10), dp(0), dp(10)

                    # Livello di qualità
                    BoxLayout:
                        size_hint_y: None
                        height: dp(300) # Altezza sufficiente a contenere 6 bottoni + label
                        spacing: dp(8)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(15), 0, dp(15), 0
                        WhiteWineLabel: # Etichetta per vino bianco
                            text: "Livello di Qualità"
                            font_size: '18sp'
                            size_hint_x: 0.5
                            size_hint_y: 1.0
                            valign: 'center'
                            text_size: self.size
                            padding_y: dp(10)

                        BoxLayout: # Contenitore dei 6 bottoni
                            id: qualita_bianco_box
                            orientation: 'vertical'
                            spacing: dp(5)
                            size_hint_y: None
                            height: self.minimum_height
                            size_hint_x: 0.5

                            SelectionButton:
                                id: qualita_difettoso
                                text: "Difettoso"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0 # Colore Bianco/Giallo
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)
                            SelectionButton:
                                id: qualita_mediocre
                                text: "Mediocre"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)
                            SelectionButton:
                                id: qualita_discreto
                                text: "Discreto"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)
                            SelectionButton:
                                id: qualita_buono
                                text: "Buono"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)
                            SelectionButton:
                                id: qualita_molto_buono
                                text: "Molto Buono"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)
                            SelectionButton:
                                id: qualita_eccellente
                                text: "Eccellente"
                                font_size: '18sp'
                                size_hint_x: 1.0
                                size_hint_y: None
                                height: dp(40)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_button_press('qualita_bianco', self, self.parent.children)

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10)


            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'palato_bianco' # Torna al palato bianco

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'info_bianco' # Va alla schermata informazioni bianco


