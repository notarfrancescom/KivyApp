                                    color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_rosato', self)

                            # Profumo Secondari (GridLayout verticale a colonna singola)
                            GridLayout:
                                id: profumo_secondari_rosato_box
