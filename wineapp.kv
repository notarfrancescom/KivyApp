        text: root.wine_data.get('qualita_bianco', 'N/D')
        font_size: root.height * 0.25
        font_name: 'materiale/comicbd.ttf'
        bold: True
        halign: 'center'
        valign: 'middle'
        size_hint_x: 0.18 # 20% della larghezza
        color: 0.12, 0.12, 0.12, 1 # Antracite

#==============================================================================
