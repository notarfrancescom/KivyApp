        valign: 'middle'
        size_hint_x: 0.1 # 15% della larghezza
        color: 0.12, 0.12, 0.12, 1 # Antracite

    # =========================================================================
    # COLONNA 4: Giudizio Finale (Etichetta singola)
    # =========================================================================
