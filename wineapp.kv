                                height: dp(20)

                    # ----------------------------------------------
                    # PERSISTENZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: persistenza_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(10), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Persistenza"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: persistenza_corta_bianco
                            text: "Corta"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('persistenza_bianco', self, self.parent.children)
                        SelectionButton:
