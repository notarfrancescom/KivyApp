                            on_release: root.on_button_press('intensita_naso_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_naso_alta
                            text: "Alta"
                            color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                            font_size: '16sp'
                            size_hint_x: 0.23
                            on_release: root.on_button_press('intensita_naso_rosato', self, self.parent.children)

                    # ------------------------------------------------
                    # PROFUMO (GRIGLIA DI SELEZIONE MULTIPLA) con Grid
                    # ------------------------------------------------
                    BoxLayout:
                        id: profumo_rosato_box
                        orientation: 'horizontal' # Contenitore principale orizzontale
                        size_hint_y: None
                        height: dp(250) # Altezza necessaria per le 7 opzioni Primari
