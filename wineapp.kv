                            font_size: '13sp'
                            size_hint_x: 0.2
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('acidita_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_acidita_alta
                            text: "Alta"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('acidita_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # TANNICITÀ (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: tannicita_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Tannicità"
                            size_hint_x: 0.3
