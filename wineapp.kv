# -*- coding: utf-8 -*-
#: import FadeTransition kivy.uix.screenmanager.FadeTransition
#: import dp kivy.metrics.dp
#: import sp kivy.metrics.sp
#: import RoundedButton main.RoundedButton

# ==============================================================================
# STILI RIUTILIZZABILI
# ==============================================================================

<StartImageButton@ButtonBehavior+Image>:
    # L'altezza viene calcolata dinamicamente in base alla larghezza
    # e al rapporto dell'immagine (image_ratio), che Kivy imposta
    # automaticamente dopo il caricamento dell'immagine.
    # Aggiungiamo un check per image_ratio > 0 per prevenire divisioni per zero
    # prima che l'immagine sia caricata.
    height: self.width / self.image_ratio if self.image_ratio > 0 else dp(50)
    allow_stretch: True
    keep_ratio: True

# Nuovo stile: non eredita più da @Button ma da @ButtonBehavior+Image
<MenuButton@ButtonBehavior+Image>:
    # L'immagine viene definita tramite 'source' invece di 'background_normal'
    source: 'materiale/menu_tre_linee.png'

    # Dimensioni quadrate e fisse
    size_hint: None, None
    size: dp(45), dp(45)

    # Fondamentale per la resa grafica pulita
    allow_stretch: True
    keep_ratio: True

    # Opzionale: cambia immagine quando premuto
    on_press: self.source = 'materiale/menu_tre_linee_cliccato.png'
    on_release: self.source = 'materiale/menu_tre_linee.png'

# Stile per le etichette con il colore del tema
<RedWineLabel@Label>:
    font_name: 'materiale/comicbd.ttf'
    font_size: '16sp'
    bold: True
    color: 0.6, 0, 0, 1  # Rosso Scuro-Bordeaux

<WhiteWineLabel@Label>:
    font_name: 'materiale/comicbd.ttf'
    font_size: '16sp'
    bold: True
    color: 0.7, 0.5, 0.0, 1.0  # Giallo-oro--ocra-scuro

<PinkWineLabel@Label>:
    font_name: 'materiale/comicbd.ttf'
    font_size: '16sp'
    bold: True
    color: 0.7, 0.45, 0.6, 1.0  # malva scuro

# Stile per i bottoni di selezione in vista, naso, palato
<SelectionButton@Button>:
    font_name: 'materiale/comicbd.ttf'
    background_normal: ''
    background_down: ''
    background_color: 0.9, 0.9, 0.9, 0.7  # Bianco sporco e trasparenza al 70%

    border: 12, 12, 12, 12
    size_hint_y: None
    height: dp(48) # Altezza minima per un buon touch target
    # Rimuovi i colori personalizzati specifici dai bottoni nel KV per usare
    # il colore del testo definito nello stile globale, altrimenti è sovrascritto
    color: 0.6, 0, 0, 1  # Colore testo ereditato da RedWineLabel (Rosso Bordeaux)


# Stile per il testo all'interno del menu a discesa dello Spinner
<SpinnerOption>:
    font_size: '10sp'  # Regola questo valore (es. 10) in base alle tue esigenze
    size_hint_y: None
    height: dp(18)


# Stile per i bottoni di navigazione in vista, naso, palato (Indietro, Avanti e Salva Scheda)
<NavigationButton@Button>:
    font_name: 'materiale/comicbd.ttf'
	# Rimuove la texture predefinita del bottone Kivy
	background_normal: ''
	background_down: ''
	font_size: '24sp'
	background_color: 0.9, 0.9, 0.9, 0  # Bianco sporco e trasparenza al 100%
	# COLORE PERSONALIZZATO (Azzurro Cielo Chiaro)
	color: 0.529, 0.808, 0.980, 1


# ==============================================================================
# 1. WelcomeScreen (name: 'welcome') - Layout Responsivo
# ==============================================================================
<WelcomeScreen>:
    name: 'welcome'

    RelativeLayout:
        size: root.size

        # 1. Immagine di Sfondo (Pieno schermo - Opzione B riuscita)
        Image:
            source: 'materiale/iniziale.png'
            size_hint: 1, 1
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            allow_stretch: True
            keep_ratio: False

        # 2. Menu Button e ancora (Semplificati e ordinati)
        # L'ancora serve al Python per sapere dove far apparire il menu a tendina
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # Posizionato appena sotto il tasto

        MenuButton:
            # Grazie al nuovo stile @ButtonBehavior+Image, qui basta il pos_hint
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # 3. Pulsante "Inizia"
        StartImageButton:
            source: "materiale/inizia.png"
            size_hint_x: 0.5
            size_hint_y: None
            height: self.width * 0.35
            pos_hint: {"center_x": 0.5, "y": 0.1}
            on_release: root.manager.current = 'selection'


# ==============================================================================
# 2. WineSelectionScreen (name: 'selection') - AGGIORNATO CON LAYOUT RESPONSIVO
# ==============================================================================
<WineSelectionScreen>:
    name: 'selection'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCHOR (Spostati fuori dal BoxLayout per fissità)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a WelcomeScreen

        MenuButton:
            # COORDINATE IDENTICHE ALLA WELCOME SCREEN
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # -----------------------------------------------------------------
        # 2. CONTENITORE PRINCIPALE (Contenuto centrale)
        # -----------------------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: dp(10)
            padding: dp(10)

            # Spazio vuoto superiore per non sovrapporsi al MenuButton
            Widget:
                size_hint_y: 0.1

            # TITOLO: Che vino stai degustando
            Image:
                source: "materiale/che_vino_stai_degustando.png"
                size_hint_y: 0.15
                allow_stretch: True
                keep_ratio: True

            # CONTENITORE BOTTONI (Corpo centrale)
            RelativeLayout:
                size_hint_y: 0.7

                Image:
                    source: "materiale/rosso_bianco_rosato.png"
                    size_hint: 1, 1
                    allow_stretch: True
                    keep_ratio: False

                Button:
                    background_normal: "materiale/rosso.png"
                    background_down: "materiale/rosso_cliccato.png"
                    size_hint: 0.4, 0.4
                    pos_hint: {"x": 0, "center_y": 0.52}
                    on_release: root.manager.current = 'vista_rosso'

                Button:
                    background_normal: "materiale/bianco.png"
                    background_down: "materiale/bianco_cliccato.png"
                    size_hint: 0.4, 0.4
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    on_release: root.manager.current = 'vista_bianco'

                Button:
                    background_normal: "materiale/rosato.png"
                    background_down: "materiale/rosato_cliccato.png"
                    size_hint: 0.4, 0.4
                    pos_hint: {"right": 0.99, "center_y": 0.5}
                    on_release: root.manager.current = 'vista_rosato'

            Widget:
                size_hint_y: 0.05


# ==============================================================================
# 3a. RedWineViewScreen (name: 'vista_rosso') - RIVISTO CON STRUTTURA RESPONSIVA
# ==============================================================================
<RedWineViewScreen>:
    name: 'vista_rosso'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCORA (Spostati qui per essere fissi ovunque)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a Welcome e Selection

        MenuButton:
            id: menu_button
            # COORDINATE IDENTICHE PER EVITARE IL "SALTO" VISIVO
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO (Fisso in alto)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                # Altezza fissa aumentata per includere lo spazio del menu
                height: dp(130)
                spacing: dp(5)
                # Padding laterale standard
                padding: dp(12), dp(5), dp(12), dp(0)

                Widget:
                    size_hint_y: None
                    height: dp(40)

                # Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1 # Occupa lo spazio rimanente nell'Header
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Rosso (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_rosso.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Vista Rosso (Titolo "Analisi Visiva")
                    Image:
                        source: 'materiale/base_vista_rosso.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView (Questo è l'unico figlio consentito)
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10) # Padding top/bottom interno
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # LIMIPIDEZZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: limpidezza_rosso_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48) # Altezza basata sull'altezza dei SelectionButton
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0

                        RedWineLabel:
                            text: "Limpidezza"
                            size_hint_x: 0.4 # Più spazio per l'etichetta
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_limpido
                            text: "Limpido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('limpidezza_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_torbido
                            text: "Torbido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('limpidezza_rosso', self, self.parent.children)

                    # ----------------------------------------------
                    # INTENSITÀ VISTA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: intensita_vista_rosso_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0

                        RedWineLabel:
                            text: "Intensità"
                            size_hint_x: 0.3
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_intensita_vista_pallido
                            text: "Pallido"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_vista_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_medio
                            text: "Medio"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_vista_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_intenso
                            text: "Intenso"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_vista_rosso', self, self.parent.children)

                    # ------------------------------------------------------
                    # COLORE (SELEZIONE MULTIPLA) - RISTRUTTURATO E CENTRATO
                    # ------------------------------------------------------
                    BoxLayout:
                        id: colore_rosso_box
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(5)
                        # Padding sinistro e destro
                        padding: dp(10), 0, dp(10), 0

                        # Prima Riga: Etichetta + 2 Bottoni
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(5)

                            RedWineLabel:
                                text: "Colore"
                                size_hint_x: 0.3 # Spazio per l'etichetta
                                valign: 'center'
                                text_size: self.size

                            # Contenitore per i 2 bottoni con spacer per la centratura
                            BoxLayout:
                                orientation: 'horizontal'
                                size_hint_x: 0.7 # Prende lo spazio rimanente
                                spacing: dp(20) # AUMENTATO lo spacing tra i due bottoni a dp(20)

                                # Spacer 1 per centrare
                                Widget:
                                    size_hint_x: 0.05 # RICALIBRATO: ridotto per dare più spazio ai bottoni

                                SelectionButton:
                                    id: btn_colore_porpora
                                    text: "Porpora"
                                    font_size: '16sp' # AUMENTATO il font a 16sp
                                    size_hint_x: 0.4 # RICALIBRATO: aumentato per un bottone più grande
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('colore_rosso', self)

                                SelectionButton:
                                    id: btn_colore_rubino
                                    text: "Rubino"
                                    font_size: '16sp' # AUMENTATO il font a 16sp
                                    size_hint_x: 0.4 # RICALIBRATO: aumentato per un bottone più grande
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('colore_rosso', self)

                                # Spacer 2 per centrare e completare lo spazio
                                Widget:
                                    size_hint_x: 0.05 # RICALIBRATO: bilancia lo spazio rimanente

                        # Seconda Riga: GridLayout per i 3 Bottoni rimanenti
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48) # Altezza della griglia
                            spacing: dp(5) # Spazio tra l'etichetta e i bottoni (se non ci fosse lo spacer)

                            # MODIFICA: Spacer per simulare l'ingombro della RedWineLabel sopra
                            Widget:
                                size_hint_x: 0.3 # Deve essere uguale a RedWineLabel size_hint_x (0.3)

                            # Contenitore della griglia
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_x: 0.7 # Deve essere uguale a size_hint_x del contenitore bottoni sopra (0.7)
                                size_hint_y: None
                                height: self.minimum_height
                                padding: dp(0) # Rimuovi padding

                                # GridLayout effettivo
                                GridLayout:
                                    cols: 3
                                    size_hint_y: None
                                    height: dp(48) # Altezza di una singola riga di bottoni
                                    spacing: dp(12) # Spacing orizzontale/verticale

                                    SelectionButton:
                                        id: btn_colore_granata
                                        text: "Granata"
                                        font_size: '16sp'
                                        color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                        on_release: root.on_multiple_select_press('colore_rosso', self)
                                    SelectionButton:
                                        id: btn_colore_mattone
                                        text: "Mattone"
                                        font_size: '16sp'
                                        color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                        on_release: root.on_multiple_select_press('colore_rosso', self)
                                    SelectionButton:
                                        id: btn_colore_marrone
                                        text: "Marrone"
                                        font_size: '16sp'
                                        color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                        on_release: root.on_multiple_select_press('colore_rosso', self)


                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'selection'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1 if app.card_to_update_id == None else 0
                    disabled: True if app.card_to_update_id != None else False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'naso_rosso'

# ==============================================================================
# 3b. WhiteWineViewScreen (name: 'vista_bianco') - AGGIORNATO RESPONSIVITÀ
# ==============================================================================
<WhiteWineViewScreen>:
    name: 'vista_bianco'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO (Fisso in alto) - Aggiornato per includere il Menu Button
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                # Altezza aumentata per riservare spazio al menu in alto
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor (FloatLayout per la sovrapposizione)
                FloatLayout:
                    size_hint_y: None
                    height: dp(40) # Spazio verticale dedicato al Menu Button

                    # 1a. ANCORA INVISIBILE (Necessaria per il DropDownMenu)
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        # Posizionalo in alto a destra
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON (Il bottone effettivo)
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1 # Occupa lo spazio rimanente nell'Header
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Bianco (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_bianco.png'
                        size_hint_y: 0.75 # Adattato per l'altezza maggiore
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Vista Bianco (Titolo "Analisi Visiva")
                    Image:
                        source: 'materiale/base_vista_bianco.png'
                        size_hint_y: 0.25 # Adattato per l'altezza maggiore
                        allow_stretch: True
                        keep_ratio: False

            # SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0)

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10)
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # LIMIPIDEZZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: limpidezza_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0 # Aggiunto padding

                        WhiteWineLabel:
                            text: "Limpidezza"
                            size_hint_x: 0.4
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_limpido
                            text: "Limpido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            on_release: root.on_button_press('limpidezza_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_torbido
                            text: "Torbido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            on_release: root.on_button_press('limpidezza_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # INTENSITÀ VISTA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: intensita_vista_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0 # Aggiunto padding

                        WhiteWineLabel:
                            text: "Intensità"
                            size_hint_x: 0.3
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_intensita_vista_pallido
                            text: "Pallido"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            on_release: root.on_button_press('intensita_vista_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_medio
                            text: "Medio"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            on_release: root.on_button_press('intensita_vista_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_intenso
                            text: "Intenso"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            on_release: root.on_button_press('intensita_vista_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # COLORE (SELEZIONE MULTIPLA) - RISTRUTTURATO PER ALLINEAMENTO
                    # ----------------------------------------------
                    BoxLayout:
                        id: colore_bianco_box
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(5)
                        # Padding sinistro e destro
                        padding: dp(10), 0, dp(10), 0 # Aggiunto padding

                        # Riga 1: Etichetta "Colore"
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48)
                            spacing: dp(5)

                            WhiteWineLabel:
                                text: "Colore"
                                size_hint_x: 0.3 # Deve matchare lo spacer
                                valign: 'center'
                                text_size: self.size

                            # Contenitore per i 2 bottoni con spacer per la centratura
                            BoxLayout:
                                orientation: 'horizontal'
                                size_hint_x: 0.7 # Prende lo spazio rimanente
                                spacing: dp(20) # AUMENTATO lo spacing tra i due bottoni a dp(20)

                                # Spacer 1 per centrare
                                Widget:
                                    size_hint_x: 0.05 # RICALIBRATO: ridotto per dare più spazio ai bottoni

                                SelectionButton:
                                    id: btn_colore_giallo_lime
                                    text: "Giallo lime"
                                    font_size: '16sp'
                                    color: 0.9, 0.7, 0.1, 1.0
                                    on_release: root.on_multiple_select_press('colore_bianco', self)
                                SelectionButton:
                                    id: btn_colore_paglierino
                                    text: "Paglierino"
                                    font_size: '16sp'
                                    color: 0.9, 0.7, 0.1, 1.0
                                    on_release: root.on_multiple_select_press('colore_bianco', self)

                                # Spacer 2 per centrare e completare lo spazio
                                Widget:
                                    size_hint_x: 0.05 # RICALIBRATO: bilancia lo spazio rimanente

                        # Seconda Riga: GridLayout per i 3 Bottoni rimanenti
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(48) # Altezza della griglia
                            spacing: dp(5) # Spazio tra l'etichetta e i bottoni (se non ci fosse lo spacer)

                            # MODIFICA: Spacer per simulare l'ingombro della RedWineLabel sopra
                            Widget:
                                size_hint_x: 0.3 # Deve essere uguale a RedWineLabel size_hint_x (0.3)

                            # Contenitore della griglia
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_x: 0.7 # Deve essere uguale a size_hint_x del contenitore bottoni sopra (0.7)
                                size_hint_y: None
                                height: self.minimum_height
                                padding: dp(0) # Rimuovi padding

                                # GridLayout effettivo
                                GridLayout:
                                    cols: 3
                                    size_hint_y: None
                                    height: dp(48) # Altezza di una singola riga di bottoni
                                    spacing: dp(12) # Spacing orizzontale/verticale

                                    SelectionButton:
                                        id: btn_colore_oro
                                        text: "Oro"
                                        font_size: '16sp'
                                        color: 0.9, 0.7, 0.1, 1.0
                                        on_release: root.on_multiple_select_press('colore_bianco', self)
                                    SelectionButton:
                                        id: btn_colore_ambrato
                                        text: "Ambrato"
                                        font_size: '16sp'
                                        color: 0.9, 0.7, 0.1, 1.0
                                        on_release: root.on_multiple_select_press('colore_bianco', self)
                                    SelectionButton:
                                        id: btn_colore_marrone
                                        text: "Marrone"
                                        font_size: '16sp'
                                        color: 0.9, 0.7, 0.1, 1.0
                                        on_release: root.on_multiple_select_press('colore_bianco', self)

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale


            # FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'selection'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1 if app.card_to_update_id == None else 0
                    disabled: True if app.card_to_update_id != None else False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'naso_bianco'


# ==============================================================================
# 3c. PinkWineViewScreen (name: 'vista_rosato') - AGGIORNATO RESPONSIVITÀ
# ==============================================================================
<PinkWineViewScreen>:
    name: 'vista_rosato'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO (Fisso in alto) - Aggiornato per includere il Menu Button
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                # Altezza aumentata per riservare spazio al menu in alto
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor (FloatLayout per la sovrapposizione)
                FloatLayout:
                    size_hint_y: None
                    height: dp(40) # Spazio verticale dedicato al Menu Button

                    # 1a. ANCORA INVISIBILE (Necessaria per il DropDownMenu)
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        # Posizionalo in alto a destra
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON (Il bottone effettivo)
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1 # Occupa lo spazio rimanente nell'Header
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Rosato (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_rosato.png'
                        size_hint_y: 0.75 # Adattato per l'altezza maggiore
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Vista Rosato (Titolo "Analisi Visiva")
                    Image:
                        source: 'materiale/base_vista_rosato.png'
                        size_hint_y: 0.25 # Adattato per l'altezza maggiore
                        allow_stretch: True
                        keep_ratio: False

            # SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0)

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10)
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # LIMIPIDEZZA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: limpidezza_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0 # Aggiunto padding

                        PinkWineLabel:
                            text: "Limpidezza"
                            size_hint_x: 0.4
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_limpido
                            text: "Limpido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.85, 0.6, 0.8, 1.0 # malva chiaro e delicato
                            on_release: root.on_button_press('limpidezza_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_torbido
                            text: "Torbido"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.85, 0.6, 0.8, 1.0 # malva chiaro e delicato
                            on_release: root.on_button_press('limpidezza_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # INTENSITÀ VISTA (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: intensita_vista_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0

                        PinkWineLabel:
                            text: "Intensità"
                            size_hint_x: 0.3
                            valign: 'center'
                            text_size: self.size

                        SelectionButton:
                            id: btn_intensita_vista_pallido
                            text: "Pallido"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('intensita_vista_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_medio
                            text: "Medio"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('intensita_vista_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_vista_intenso
                            text: "Intenso"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.85, 0.6, 0.8, 1.0
                            on_release: root.on_button_press('intensita_vista_rosato', self, self.parent.children)

                    # ----------------------------------------------
                    # COLORE (SELEZIONE MULTIPLA) - ORA TUTTO SU UNA RIGA
                    # ----------------------------------------------
                    BoxLayout:
                        id: colore_rosato_box
                        orientation: 'horizontal' # Contenitore principale orizzontale
                        size_hint_y: None
                        height: dp(48) # Altezza fissa per una riga di bottoni/etichetta
                        spacing: dp(5)
                        # Padding sinistro e destro
                        padding: dp(10), 0, dp(10), 0

                        PinkWineLabel:
                            text: "Colore"
                            size_hint_x: 0.3 # Spazio riservato all'etichetta
                            valign: 'center'
                            text_size: self.size

                        # Contenitore per la griglia (usa il 70% dello spazio rimanente)
                        GridLayout:
                            #id: colore_rosato_box
                            cols: 3
                            size_hint_x: 0.7 # Occupa il resto dello spazio
                            size_hint_y: 1 # Deve occupare tutta l'altezza del BoxLayout
                            spacing: dp(5) # Spacing orizzontale/verticale

                            SelectionButton:
                                id: btn_colore_rosa
                                text: "Rosa"
                                font_size: '16sp'
                                size_hint_x: 0.2
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('colore_rosato', self)
                            SelectionButton:
                                id: btn_colore_rosa_arancio
                                text: "Rosa arancio"
                                font_size: '16sp'
                                size_hint_x: 0.45
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('colore_rosato', self)
                            SelectionButton:
                                id: btn_colore_arancione
                                text: "Arancione"
                                font_size: '16sp'
                                size_hint_x: 0.35
                                color: 0.85, 0.6, 0.8, 1.0
                                on_release: root.on_multiple_select_press('colore_rosato', self)


                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'selection'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1 if app.card_to_update_id == None else 0
                    disabled: True if app.card_to_update_id != None else False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'naso_rosato'

# ==============================================================================
# 4a. RedWineNoseScreen (name: 'naso_rosso') CON STRUTTURA RESPONSIVA
# ==============================================================================
<RedWineNoseScreen>:
    name: 'naso_rosso'

    FloatLayout:
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # -----------------------------------------------------------------
        # 1. MENU BUTTON E ANCHOR (Fissi e indipendenti dai BoxLayout)
        # -----------------------------------------------------------------
        Widget:
            id: menu_anchor
            size_hint: None, None
            size: dp(1), dp(1)
            pos_hint: {"right": 0.95, "top": 0.92} # IDENTICO a tutte le altre schermate

        MenuButton:
            id: menu_button
            # Coordinate bloccate per eliminare il "salto" visivo
            pos_hint: {"right": 0.98, "top": 0.98}
            on_release: app.show_main_menu(root.ids.menu_anchor)

        # -----------------------------------------------------------------
        # 2. BOX CONTENITORE VERTICALE PRINCIPALE
        # -----------------------------------------------------------------
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # HEADER / TITOLO
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130)
                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # --- RIMOSSO IL VECCHIO FLOATLAYOUT DEL MENU ---
                # Aggiungiamo lo spacer per proteggere l'area del MenuButton
                Widget:
                    size_hint_y: None
                    height: dp(40)

                # Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    Image:
                        source: 'materiale/scheda_degustazione_rosso.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    Image:
                        source: 'materiale/base_naso_rosso.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10) # Padding top/bottom interno
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # CONDIZIONE (SELEZIONE ESCLUSIVA)
                    # Ho aggiornato le altezze e i font_size per uniformità
                    # ----------------------------------------------
                    BoxLayout:
                        id: condizione_rosso_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48) # Altezza standardizzata
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0
                        RedWineLabel:
                            text: "Condizione"
                            size_hint_x: 0.4
                            valign: 'center'
                            text_size: self.size
                        SelectionButton:
                            id: btn_condizione_pulito
                            text: "Pulito"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('condizione_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_condizione_non_pulito
                            text: "Non Pulito"
                            font_size: '18sp'
                            size_hint_x: 0.3
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('condizione_rosso', self, self.parent.children)

                    # ----------------------------------------------
                    # INTENSITÀ NASO (SELEZIONE ESCLUSIVA)
                    # Ho aggiornato le altezze e i font_size per uniformità
                    # ----------------------------------------------
                    BoxLayout:
                        id: intensita_naso_rosso_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0
                        RedWineLabel:
                            text: "Intensità"
                            size_hint_x: 0.3
                            valign: 'center'
                            text_size: self.size
                        SelectionButton:
                            id: btn_intensita_naso_bassa
                            text: "Bassa"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_naso_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_naso_media
                            text: "Media"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_naso_rosso', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_naso_alta
                            text: "Alta"
                            font_size: '16sp'
                            size_hint_x: 0.23
                            color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                            on_release: root.on_button_press('intensita_naso_rosso', self, self.parent.children)

                    # ----------------------------------------------
                    # PROFUMO (GRIGLIA DI SELEZIONE MULTIPLA) - CORREZIONE LAYOUT
                    # ----------------------------------------------
                    BoxLayout:
                        id: profumo_rosso_box
                        orientation: 'horizontal' # Contenitore principale orizzontale
                        size_hint_y: None
                        # Altezza aumentata per contenere 6 bottoni + etichetta
                        height: dp(220)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0

                        RedWineLabel:
                            text: "Profumo"
                            size_hint_x: 0.3 # Spazio per l'etichetta
                            valign: 'top'
                            text_size: self.size
                            padding_y: dp(10)

                        BoxLayout: # Contenitore Griglie
                            orientation: 'horizontal'
                            spacing: dp(5)
                            size_hint_x: 0.7

                            # Profumo Primari (GridLayout verticale a colonna singola)
                            GridLayout:
                                id: profumo_primari_rosso_box
                                cols: 1
                                spacing: dp(2)
                                RedWineLabel:
                                    text: "Primari"
                                    color: 0.6, 0, 0, 1
                                    font_size: '13sp'
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Ciliegia"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Mora"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Peperone\n  verde"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Prugna"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: " Ribes\n  nero"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Violetta"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)

                            # Profumo Secondari (GridLayout verticale a colonna singola - pulito da widget inutili)
                            GridLayout:
                                id: profumo_secondari_rosso_box
                                cols: 1
                                spacing: dp(2)
                                RedWineLabel:
                                    text: "Secondari"
                                    font_size: '13sp'
                                    color: 0.6, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Burro"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Lievito"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "  Pane\ntostato"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                # Spaziatori per allineare l'altezza con le altre due colonne (per 6 righe di bottoni)
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone
                                Widget:
                                    size_hint_y: None
                                    height: dp(20) # Altezza approssimativa di un bottone

                            # Profumo Terziari (GridLayout verticale a colonna singola)
                            GridLayout:
                                id: profumo_terziari_rosso_box
                                cols: 1
                                spacing: dp(2)
                                RedWineLabel:
                                    text: "Terziari"
                                    font_size: '13sp'
                                    color: 0.6, 0, 0, 1
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Cacao"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Catrame"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Cuoio"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Spezie"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Tabacco"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)
                                SelectionButton:
                                    text: "Vaniglia"
                                    font_size: '14sp'
                                    color: 0.6, 0.2, 0.4, 1 # COLORE PERSONALIZZATO (Viola-Rosso)
                                    on_release: root.on_multiple_select_press('profumo_rosso', self)

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'vista_rosso'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1 #if app.card_to_update_id == None else 0
                    disabled: False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'palato_rosso'


#==============================================================================
#4b. WhiteWineNoseScreen (name: 'naso_bianco') CON STRUTTURA RESPONSIVA
#==============================================================================

<WhiteWineNoseScreen>:
    name: 'naso_bianco'

    FloatLayout:
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto) - STESSO ALTEZZA E STRUTTURA DI VISTA_ROSSO/NASO_ROSSO
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                # Altezza fissa aumentata per includere lo spazio del menu
                height: dp(130)
                spacing: dp(5)
                # Padding laterale standard
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor (FloatLayout per la sovrapposizione)
                FloatLayout:
                    size_hint_y: None
                    height: dp(40) # Spazio verticale dedicato al Menu Button

                    # 1a. ANCORA INVISIBILE (Necessaria per il DropDownMenu)
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON (Il bottone effettivo)
                    MenuButton:
                        id: menu_button # <--- ID AGGIUNTO per il reset dello stato
                        # Posizione leggermente aggiustata per coerenza visiva
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1 # Occupa lo spazio rimanente nell'Header
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Bianco (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_bianco.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Naso Bianco (Titolo "Analisi Olfattiva")
                    Image:
                        source: 'materiale/base_naso_bianco.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10) # Padding top/bottom interno
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # CONDIZIONE (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: condizione_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48) # Altezza standardizzata
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0
                        WhiteWineLabel:
                            text: "Condizione"
                            size_hint_x: 0.4
                            valign: 'center'
                            text_size: self.size
                        SelectionButton:
                            id: btn_condizione_pulito
                            text: "Pulito"
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            font_size: '18sp'
                            size_hint_x: 0.3
                            on_release: root.on_button_press('condizione_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_condizione_non_pulito
                            text: "Non Pulito"
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            font_size: '18sp'
                            size_hint_x: 0.3
                            on_release: root.on_button_press('condizione_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # INTENSITÀ NASO (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: intensita_naso_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0
                        WhiteWineLabel:
                            text: "Intensità"
                            size_hint_x: 0.3
                            valign: 'center'
                            text_size: self.size
                        SelectionButton:
                            id: btn_intensita_naso_bassa
                            text: "Bassa"
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            font_size: '16sp'
                            size_hint_x: 0.23
                            on_release: root.on_button_press('intensita_naso_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_naso_media
                            text: "Media"
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            font_size: '16sp'
                            size_hint_x: 0.23
                            on_release: root.on_button_press('intensita_naso_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_intensita_naso_alta
                            text: "Alta"
                            color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                            font_size: '16sp'
                            size_hint_x: 0.23
                            on_release: root.on_button_press('intensita_naso_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # PROFUMO (GRIGLIA DI SELEZIONE MULTIPLA) - LAYOUT CORRETTO CON GRID
                    # ----------------------------------------------
                    BoxLayout:
                        id: profumo_bianco_box
                        orientation: 'horizontal' # Contenitore principale orizzontale
                        size_hint_y: None
                        # Altezza aumentata per contenere 7 bottoni + etichetta
                        height: dp(250)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0

                        WhiteWineLabel:
                            text: "Profumo"
                            size_hint_x: 0.3 # Spazio per l'etichetta
                            valign: 'top'
                            text_size: self.size
                            padding_y: dp(10)

                        BoxLayout: # Contenitore Griglie (orizzontale)
                            orientation: 'horizontal'
                            spacing: dp(5)
                            size_hint_x: 0.7

                            # Profumo Primari (GridLayout verticale a colonna singola) - 7 opzioni
                            GridLayout:
                                id: profumo_primari_bianco_box
                                cols: 1
                                spacing: dp(2)
                                WhiteWineLabel:
                                    text: "Primari"
                                    font_size: '13sp'
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Albicocca"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Ananas"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Banana"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Limone"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Mango"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Pesca"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Pompelmo"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)

                            # Profumo Secondari (GridLayout verticale a colonna singola) - 4 opzioni + 3 spaziatori
                            GridLayout:
                                id: profumo_secondari_bianco_box
                                cols: 1
                                spacing: dp(2)
                                WhiteWineLabel:
                                    text: "Secondari"
                                    font_size: '13sp'
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Basilico"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: " Fiori \nbianchi"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Salvia"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Timo"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                # Spaziatori per allineare l'altezza con le 7 righe (7 totali con l'etichetta)
                                Widget:
                                Widget:
                                Widget:

                            # Profumo Terziari (GridLayout verticale a colonna singola) - 4 opzioni + 3 spaziatori
                            GridLayout:
                                id: profumo_terziari_bianco_box
                                cols: 1
                                spacing: dp(2)
                                WhiteWineLabel:
                                    text: "Terziari"
                                    font_size: '13sp'
                                    size_hint_y: None
                                    height: dp(15)
                                SelectionButton:
                                    text: "Cannella"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: " Note\nminerali"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Vaniglia"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                SelectionButton:
                                    text: "Zafferano"
                                    color: 0.9, 0.7, 0.1, 1.0  # Giallo-oro luminoso
                                    font_size: '15sp'
                                    on_release: root.on_multiple_select_press('profumo_bianco', self)
                                # Spaziatori per allineare l'altezza con le 7 righe (7 totali con l'etichetta)
                                Widget:
                                Widget:
                                Widget:

                    # WIDGET VUOTO PER ASSORBIRE LO SPAZIO IN ECCESSO E FORZARE MINIMUM_HEIGHT
                    Widget:
                        size_hint_y: None
                        height: dp(10) # Padding finale

            # ⬇️ FOOTER / NAVIGAZIONE (Fisso in basso)
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(60)
                padding: dp(10)
                spacing: dp(20)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'vista_bianco'

                    # L'opacità è 1 (visibile) se app.card_to_update_id è None. 0 (nascosto) altrimenti.
                    opacity: 1
                    disabled: False

                NavigationButton:
                    text: "Avanti"
                    on_release: root.manager.current = 'palato_bianco'

# ==============================================================================
# 4c. PinkWineNoseScreen (name: 'naso_rosato') CON STRUTTURA RESPONSIVA
# ==============================================================================
<PinkWineNoseScreen>:
    name: 'naso_rosato'

    FloatLayout:
        # Sfondo (fisso)
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content + Footer)
        BoxLayout:
            orientation: 'vertical'
            size: root.size

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto)
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                # Altezza fissa per coerenza
                height: dp(130)
                spacing: dp(5)
                # Padding laterale standard
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor (FloatLayout per la sovrapposizione)
                FloatLayout:
                    size_hint_y: None
                    height: dp(40) # Spazio verticale dedicato al Menu Button

                    # 1a. ANCORA INVISIBILE (Necessaria per il DropDownMenu)
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON (Il bottone effettivo)
                    MenuButton:
                        id: menu_button # ID AGGIUNTO per il reset dello stato
                        # Posizione leggermente aggiustata per coerenza visiva
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1 # Occupa lo spazio rimanente nell'Header
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Rosato (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_rosato.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Naso Rosato (Titolo "Analisi Olfattiva")
                    Image:
                        source: 'materiale/base_naso_rosato.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(15) # Spaziatura consistente
                    padding: dp(0), dp(10), dp(3), dp(10) # Padding top/bottom interno
                    size_hint_y: None
                    height: self.minimum_height # Altezza dinamica in base al contenuto

                    # ----------------------------------------------
                    # CONDIZIONE (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: condizione_rosato_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48) # Altezza standardizzata
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(10), 0
                        PinkWineLabel:
                            text: "Condizione"
                            size_hint_x: 0.4
                            valign: 'center'
                            text_size: self.size
                        SelectionButton:
                            id: btn_condizione_pulito
                            text: "Pulito"
                            color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                            font_size: '18sp'
                            size_hint_x: 0.3
                            on_release: root.on_button_press('condizione_rosato', self, self.parent.children)
                        SelectionButton:
                            id: btn_condizione_non_pulito
                            text: "Non Pulito"
                            color: 0.85, 0.6, 0.8, 1.0  # malva chiaro e delicato
                            font_size: '18sp'
                            size_hint_x: 0.3
                            on_release: root.on_button_press('condizione_rosato', self, self.parent.children)

                    # ----------------------------------------------
