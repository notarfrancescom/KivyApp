                            orientation: 'horizontal'
                            spacing: dp(5)
                            size_hint_x: 0.7

                            # Profumo Primari (GridLayout verticale a colonna singola)
                            GridLayout:
                                id: profumo_primari_rosato_box
                                cols: 1
