                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('tannicita_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_tannicita_alta
                            text: "Alta"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('tannicita_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # LIVELLO ALCOLICO (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: livello_alcolico_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Liv.Alcolico"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: btn_alcol_basso
                            text: "Basso"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('livello_alcolico_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_alcol_medio
                            text: "Medio"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('livello_alcolico_bianco', self, self.parent.children)
                        SelectionButton:
                            id: btn_alcol_alto
                            text: "Alto"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('livello_alcolico_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # CORPO (SELEZIONE ESCLUSIVA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: corpo_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(20)
                        spacing: dp(5)
                        padding: dp(5), 0, dp(5), 0
                        WhiteWineLabel:
                            text: "Corpo"
                            size_hint_x: 0.3
                            font_size: '14sp'
                        SelectionButton:
                            id: corpo_basso
                            text: "Basso"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('corpo_bianco', self, self.parent.children)
                        SelectionButton:
                            id: corpo_medio
                            text: "Medio"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('corpo_bianco', self, self.parent.children)
                        SelectionButton:
                            id: corpo_alto
                            text: "Alto"
                            font_size: '13sp'
                            size_hint_x: 0.25
                            height: dp(20)
                            color: 0.9, 0.7, 0.1, 1.0
                            on_release: root.on_button_press('corpo_bianco', self, self.parent.children)

                    # ----------------------------------------------
                    # SAPORE (GRIGLIA DI SELEZIONE MULTIPLA)
                    # ----------------------------------------------
                    BoxLayout:
                        id: sapore_bianco_box
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(245)
                        spacing: dp(5)
                        padding: dp(20), 0, dp(0), 0

                        WhiteWineLabel:
                            text: "Sapore"
                            size_hint_x: 0.23
                            font_size: '14sp'
                            valign: 'center'
                            text_size: self.size
                            padding_y: dp(10)

                        GridLayout:
                            id: sapore_grid_content
                            size_hint_x: 0.77 # <-- Adeguato al 0.4 della label
                            cols: 3
                            spacing: dp(5)
                            padding: dp(5)
                            # Row 1: Intestazioni (Altezza fissa dp(7))
                            WhiteWineLabel:
                                text: "Primari"
                                font_size: '12sp'
                                color: 0.8, 0.6, 0.0, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)
                            WhiteWineLabel:
                                text: "Secondari"
                                font_size: '12sp'
                                color: 0.8, 0.6, 0.0, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)
                            WhiteWineLabel:
                                text: "Terziari"
                                font_size: '12sp'
                                color: 0.8, 0.6, 0.0, 1.0 # Colore leggermente più scuro per il titolo
                                size_hint_y: None
                                height: dp(12)

                            # Bottoni della griglia - Altezza uniforme dp(20)
                            # Row 2: Ananas / Asparagi / Cannella
                            SelectionButton:
                                id: sapore_ananas
                                text: "Ananas"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_asparagi
                                text: "Asparagi"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_cannella
                                text: "Cannella"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)

                            # Row 3: Lime / Erba tagliata / Noce moscata
                            SelectionButton:
                                id: sapore_lime
                                text: "Lime"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_erba_tagliata
                                text: " Erba\ntagliata"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_noce_moscata
                                text: "  Noce\nmo   scata"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            # Row 4: Limone / Fiori bianchi / Note minerali
                            SelectionButton:
                                id: sapore_limone
                                text: "Limone"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_fiori_bianchi
                                text: " Fiori\nbianchi"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_note_minerali
                                text: "  Note\nminerali"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            # Row 5: Mango / Foglia pomodoro / Vaniglia
                            SelectionButton:
                                id: sapore_mango
                                text: "Mango"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_folglia_pomodoro
                                text: " Foglia\npomodoro"
                                font_size: '9sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            SelectionButton:
                                id: sapore_vaniglia
                                text: "Vaniglia"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            # Row 6: Mela / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_mela
                                text: "Mela"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 7: Papaya / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_papaya
                                text: "Papaya"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 8: Pera / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_pera
                                text: "Pera"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 8: Pesca / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_pesca
                                text: "Pesca"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
                                on_release: root.on_multiple_select_press('sapore_bianco', self)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            Label: # Placeholder vuoto per allineare correttamente
                                text: ""
                                size_hint_y: None
                                height: dp(20)
                            # Row 8: Pera / (Spazio) / (Spazio)
                            SelectionButton:
                                id: sapore_pompelmo
                                text: "Pompelmo"
                                font_size: '13sp'
                                height: dp(20)
                                color: 0.9, 0.7, 0.1, 1.0
