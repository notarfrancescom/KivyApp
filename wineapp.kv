                spacing: dp(5)
                padding: dp(12), dp(5), dp(12), dp(0)

                # 1. Spazio Dedicato al Menu Button e Anchor
                FloatLayout:
                    size_hint_y: None
                    height: dp(40)

                    # 1a. ANCORA INVISIBILE
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON
                    MenuButton:
                        id: menu_button
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)

                    # Immagine Scheda Degustazione Rosato (Icona)
                    Image:
                        source: 'materiale/scheda_degustazione_rosato.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: False

                    # Immagine Base Info Rosato (Titolo "Info")
                    Image:
                        source: 'materiale/base_info_rosato.png'
                        size_hint_y: 0.25
                        allow_stretch: True
                        keep_ratio: False

            # 📜 SCROLL VIEW (Contenuto centrale che deve scorrere)
            ScrollView:
                size_hint: 1, 1
                do_scroll_x: False
                padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale

                # Contenitore INTERNO alla ScrollView
                BoxLayout:
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(15)
                    padding: dp(0), dp(10), dp(0), dp(10)

                    # Blocco vuoto iniziale per spazio
                    Widget:
                        size_hint_y: None
                        height: dp(10)

                    # Nome vino rosato
                    BoxLayout:
                        id: nome_rosato_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        PinkWineLabel:
                            text: "Nome"
                            size_hint_x: 0.35 # Bilanciamento label/input
                        TextInput:
                            id: nome_rosato
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Nome del vino"
                            multiline: False
                            size_hint_x: 0.65

                    # Produttore vino rosato
                    BoxLayout:
                        id: produttore_rosato_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        PinkWineLabel:
                            text: "Produttore"
                            size_hint_x: 0.35
                        TextInput:
                            id: produttore_rosato
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Produttore del vino"
                            multiline: False
                            size_hint_x: 0.65

                    # Annata vino rosato
                    BoxLayout:
                        id: annata_rosato_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        PinkWineLabel:
                            text: "Annata"
                            size_hint_x: 0.35
                        TextInput:
                            id: annata_rosato
                            font_name: 'materiale/comicbd.ttf'
                            font_size: '12sp'
                            hint_text: "Anno (es. 2024)"
                            multiline: False
                            input_type: 'number'
                            input_filter: 'int'
                            size_hint_x: 0.65

                    # Gradazione alcolica vino rosato (Spinner)
                    BoxLayout:
                        id: gradazione_alcolica_rosato_box
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(5)
                        # Padding sinistro e destro per staccare dal bordo
                        padding: dp(10), 0, dp(13), 0
                        PinkWineLabel:
                            text: "Vol. Alcolico"
                            size_hint_x: 0.35
                        Spinner:
                            id: alcol_rosato
                            background_normal: ""
                            background_color: (0.85, 0.6, 0.8, 1.0) # Colore Rosato
                            color: (1, 1, 1, 1) # Testo bianco
                            font_name: 'materiale/comicbd.ttf'
                            text: "Gradazione alcolica"
                            font_size: '12sp'
                            # Genera valori come 10.0, 10.5, ..., 18.0
                            values: [f'{x/10.0:.1f}' for x in range(100, 185, 5)]
                            text_size: self.size
                            halign: 'center'
                            valign: 'middle'
                            size_hint_x: 0.65

            # Controlli di navigazione (fissi in basso)
            BoxLayout:
                size_hint_y: None
                height: dp(60)
                spacing: dp(20)
                padding: dp(10)

                NavigationButton:
                    text: "Indietro"
                    on_release: root.manager.current = 'conclusioni_rosato'

                NavigationButton:
                    id: nav_salva_rosato
                    text: "Salva Scheda"
                    on_release: app.show_confirm_popup('rosato', root)


# ==============================================================================
# 8a. RedArchiveScreen (name: 'archivio_rosso') - Layout Proporzionale
# ==============================================================================
<RedArchiveScreen>:
    name: 'archivio_rosso'

    FloatLayout:
        canvas.before:
            Rectangle:
                pos: self.pos
                size: self.size
                source: 'materiale/iniziale_background.png'

        # BOX CONTENITORE VERTICALE PRINCIPALE (Header + Scrollable Content)
        BoxLayout:
            orientation: 'vertical'
            size: root.size
            spacing: dp(10)
            padding: dp(12), dp(0), dp(12), dp(12) # 12dp di padding laterale/inferiore

            # -----------------------------------------------------------------
            # HEADER / TITOLO (Fisso in alto) - ALTEZZA FISSA: 130dp
            # -----------------------------------------------------------------
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(130) # Altezza fissa per coerenza con le altre schermate
                spacing: dp(5)
                padding: dp(0), dp(5), dp(0), dp(0) # Padding verticale

                # 1. Spazio Dedicato al Menu Button e Anchor (FloatLayout per la sovrapposizione)
                FloatLayout:
                    size_hint_y: None
                    height: dp(40)
                    # Aggiunto padding laterale solo qui per il bottone Menu
                    padding: dp(12), dp(0), dp(12), dp(0)

                    # 1a. ANCORA INVISIBILE (Necessaria per il DropDownMenu)
                    Label:
                        id: menu_anchor
                        size_hint: None, None
                        width: dp(150)
                        height: dp(1)
                        # Posizionato per apparire in alto a destra
                        pos_hint: {"right": 0.95, "top": 0.95}
                        color: 0, 0, 0, 0

                    # 1b. MENU BUTTON (Il bottone effettivo)
                    MenuButton:
                        # La posizione è adattata al nuovo padding del FloatLayout
                        pos_hint: {"right": 0.955, "top": 0.57}
                        on_release: app.show_main_menu(root.ids.menu_anchor)

                # 2. Contenuto Effettivo dell'Header (Sotto il Menu)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: 1
                    spacing: dp(5)
                    padding: dp(12), dp(0), dp(12), dp(0) # Padding laterale per l'immagine

                    Image:
                        source: 'materiale/archivio_rossi_base.png'
                        size_hint_y: 1.0 # Occupa tutto lo spazio rimanente
                        allow_stretch: True
                        keep_ratio: False

            # SCROLLVIEW (Contenitore scorrevole)
            # Occupa lo spazio rimanente
            ScrollView:
                size_hint_y: 1.0 # Prende tutto lo spazio y restante nel BoxLayout principale
                do_scroll_x: False
                # Padding laterale spostato qui per centrare il contenuto scorrevole
                padding: dp(0), dp(0), dp(0), dp(0) # Rimuovi padding ScrollView, usa quello del GridLayout interno

                # GRIDLAYOUT (Contenitore dinamico delle schede)
                GridLayout:
                    id: archive_container
                    cols: 1
                    spacing: dp(10) # Spacing fisso
                    size_hint_y: None
                    # Importante: l'altezza si adatta al numero di schede figlie
                    height: self.minimum_height
                    padding: dp(0), dp(10), dp(0), dp(0) # Padding superiore per staccare dall'header


# ==============================================================================
